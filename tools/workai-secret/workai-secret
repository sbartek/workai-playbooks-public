#!/usr/bin/env bash
# workai-secret: one place for local secrets, the same command on every machine.
#
#   workai-secret set <name>                     value from stdin, or a hidden prompt; never argv
#   workai-secret get <name> [--copy]            print the value (or copy it to the clipboard)
#   workai-secret list                           names only
#   workai-secret rm <name>
#   workai-secret run [--only a,b] -- <cmd...>   run cmd with secrets as env vars (no .env file)
#   workai-secret export-systemd <name> <unit>   encrypt for a systemd unit (Linux, needs root)
#   workai-secret backend                        which store is in use and why
#
# Names: lower case, digits and . _ - /, e.g. `myapp/database-url`.
# Values: one line of printable ASCII (a trailing newline from stdin is
# dropped). The macOS keychain hands other bytes back as hex, so they are
# refused everywhere rather than stored differently per machine.
#
# Backends (forced with WORKAI_SECRET_BACKEND=keychain|secret-tool|pass):
#   keychain     macOS login keychain via `security`, service workai/<name>,
#                account workai. Written through `security -i` on stdin.
#   secret-tool  Linux desktop with a Secret Service (GNOME Keyring, KWallet):
#                attributes app=workai name=<name>.
#   pass         Linux without a Secret Service (servers, containers): one
#                GPG file per secret under ~/.password-store/workai/.
# Services that start without anyone typing a passphrase get their secrets
# from systemd-creds instead: `export-systemd` encrypts one to the host key
# (root on that host can still read it).
#
# `run` names the env var after the secret in upper snake case
# (`myapp/database-url` -> MYAPP_DATABASE_URL), or as mapped in
# the map file: lines `<name> <ENV_VAR>`, names only, no values. Map file:
# WORKAI_SECRET_MAP, default env-map next to this script.
set -u

prog=workai-secret
export LC_ALL=C
src="$0"   # follow the install link back to this checkout, for the map file
while [ -L "$src" ]; do
  t="$(readlink "$src")"; case "$t" in /*) src="$t" ;; *) src="$(dirname "$src")/$t" ;; esac
done
here="$(cd "$(dirname "$src")" && pwd)"
map_file="${WORKAI_SECRET_MAP:-$here/env-map}"
prefix=workai

die() { echo "$prog: $*" >&2; exit 1; }
usage() { sed -n '4,10p' "$0" 2>/dev/null | sed 's/^# *//' >&2; exit 2; }

valid_name() {
  case "$1" in ''|/*|*/|*//*|*..*) return 1 ;; esac
  printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9._/-]*$'
}
need_name() { valid_name "${1:-}" || die "bad name '${1:-}' (lower case, digits, . _ - /)"; }

# ------------------------------------------------------------ backend choice
backend_why=""
choose_backend() {
  if [ -n "${WORKAI_SECRET_BACKEND:-}" ]; then
    backend="$WORKAI_SECRET_BACKEND"; backend_why="forced by WORKAI_SECRET_BACKEND"
    case "$backend" in keychain|secret-tool|pass) ;; *) die "unknown backend '$backend'" ;; esac
    return
  fi
  if [ "$(uname -s)" = Darwin ] && command -v security >/dev/null 2>&1; then
    backend=keychain; backend_why="macOS: login keychain"
  elif command -v secret-tool >/dev/null 2>&1 && [ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] \
       && secret-tool search app "$prefix" >/dev/null 2>&1; then
    backend=secret-tool; backend_why="Linux with a Secret Service on D-Bus"
  elif command -v pass >/dev/null 2>&1; then
    backend=pass; backend_why="no Secret Service: GPG files in ${PASSWORD_STORE_DIR:-~/.password-store}/workai"
  else
    die "no secret store: install pass (and set it up with a GPG key), or run under a desktop session with secret-tool"
  fi
}

# --------------------------------------------------------------- value read
read_value() { # -> $value
  if [ -t 0 ]; then
    printf 'value for %s: ' "$1" >&2
    IFS= read -rs value; echo >&2
  else
    value="$(cat; echo x)"; value="${value%x}"; value="${value%$'\n'}"; value="${value%$'\r'}"
  fi
  [ -n "$value" ] || die "empty value, nothing stored"
  case "$value" in *[!\ -~]*) die "the value must be one line of printable ASCII" ;; esac
}

hex() { od -An -tx1 | tr -d ' \n'; }

# ------------------------------------------------------------------ keychain
kc_set() { printf 'add-generic-password -U -s %s/%s -a %s -l %s/%s -X %s\n' \
             "$prefix" "$1" "$prefix" "$prefix" "$1" "$(printf '%s' "$value" | hex)" \
           | security -i >/dev/null 2>&1; }
kc_get() { security find-generic-password -s "$prefix/$1" -a "$prefix" -w 2>/dev/null; }
kc_rm()  { security delete-generic-password -s "$prefix/$1" -a "$prefix" >/dev/null 2>&1; }
kc_list() {
  security dump-keychain 2>/dev/null \
    | sed -n "s#^ *\"svce\"<blob>=\"$prefix/\(.*\)\"\$#\1#p" | sort -u
}

# --------------------------------------------------------------- secret-tool
st_set() { printf '%s' "$value" | secret-tool store --label="$prefix/$1" app "$prefix" name "$1" 2>/dev/null; }
st_get() { secret-tool lookup app "$prefix" name "$1" 2>/dev/null; }
st_rm()  { secret-tool lookup app "$prefix" name "$1" >/dev/null 2>&1 && secret-tool clear app "$prefix" name "$1" 2>/dev/null; }
st_list() { secret-tool search --all app "$prefix" 2>&1 | sed -n 's/^attribute\.name = //p' | sort -u; }

# ---------------------------------------------------------------------- pass
pass_set() { printf '%s\n' "$value" | pass insert -m -f "$prefix/$1" >/dev/null 2>&1; }
pass_get() { pass show "$prefix/$1" 2>/dev/null | head -1; }
pass_rm()  { pass rm -f "$prefix/$1" >/dev/null 2>&1; }
pass_list() {
  local d="${PASSWORD_STORE_DIR:-$HOME/.password-store}/$prefix"
  [ -d "$d" ] || return 0
  (cd "$d" && find . -name '*.gpg' | sed 's#^\./##; s#\.gpg$##' | sort)
}

do_set()  { case "$backend" in keychain) kc_set "$1" ;; secret-tool) st_set "$1" ;; pass) pass_set "$1" ;; esac; }
do_get()  { case "$backend" in keychain) kc_get "$1" ;; secret-tool) st_get "$1" ;; pass) pass_get "$1" ;; esac; }
do_rm()   { case "$backend" in keychain) kc_rm "$1" ;; secret-tool) st_rm "$1" ;; pass) pass_rm "$1" ;; esac; }
do_list() { case "$backend" in keychain) kc_list ;; secret-tool) st_list ;; pass) pass_list ;; esac; }

env_name() { # secret name -> env var name
  local m=""
  [ -f "$map_file" ] && m="$(awk -v n="$1" '$1 == n { print $2; exit }' "$map_file")"
  [ -n "$m" ] && { echo "$m"; return; }
  printf '%s' "$1" | tr 'a-z./-' 'A-Z___'
}

copy() {
  if command -v pbcopy >/dev/null 2>&1; then pbcopy
  elif command -v wl-copy >/dev/null 2>&1; then wl-copy
  elif command -v xclip >/dev/null 2>&1; then xclip -selection clipboard
  else die "no clipboard tool (pbcopy, wl-copy or xclip)"; fi
}

# ---------------------------------------------------------------------- main
cmd="${1:-}"; [ $# -gt 0 ] && shift
case "$cmd" in
  set)
    [ $# = 1 ] || usage; need_name "$1"; choose_backend
    read_value "$1"
    do_set "$1" && [ "$(do_get "$1")" = "$value" ] || die "could not store $1 ($backend)"
    unset value; echo "stored $1 ($backend)" >&2 ;;
  get)
    [ $# -ge 1 ] && [ $# -le 2 ] || usage; need_name "$1"; choose_backend
    v="$(do_get "$1")" || v=""
    [ -n "$v" ] || die "no secret $1 ($backend)"
    if [ "${2:-}" = --copy ]; then printf '%s' "$v" | copy && echo "copied $1" >&2
    elif [ -n "${2:-}" ]; then usage
    else printf '%s\n' "$v"; fi ;;
  list)
    [ $# = 0 ] || usage; choose_backend; do_list ;;
  rm)
    [ $# = 1 ] || usage; need_name "$1"; choose_backend
    do_rm "$1" || die "no secret $1 ($backend)"; echo "removed $1" >&2 ;;
  run)
    only=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --only) only="${2:-}"; shift 2 || usage ;;
        --) shift; break ;;
        *) usage ;;
      esac
    done
    [ $# -gt 0 ] || usage; choose_backend
    if [ -n "$only" ]; then names="$(printf '%s' "$only" | tr ',' '\n')"; else names="$(do_list)"; fi
    for n in $names; do
      need_name "$n"
      v="$(do_get "$n")" || v=""
      [ -n "$v" ] || die "no secret $n ($backend)"
      export "$(env_name "$n")=$v"
    done
    unset v
    exec "$@" ;;
  export-systemd)
    [ $# = 2 ] || usage; need_name "$1"; choose_backend
    command -v systemd-creds >/dev/null 2>&1 || die "systemd-creds not found (Linux with systemd 250+)"
    store="${WORKAI_CREDSTORE:-/etc/credstore.encrypted}"
    cred="$(printf '%s' "$1" | tr '/' '-')"
    v="$(do_get "$1")" || v=""
    [ -n "$v" ] || die "no secret $1 ($backend)"
    printf '%s' "$v" | systemd-creds encrypt --name="$cred" - "$store/$cred" || die "systemd-creds encrypt failed (root needed for $store?)"
    unset v
    echo "wrote $store/$cred; add to $2:" >&2
    echo "  LoadCredentialEncrypted=$cred:$store/$cred" >&2
    echo "  (the unit reads it from \$CREDENTIALS_DIRECTORY/$cred)" >&2 ;;
  backend)
    [ $# = 0 ] || usage; choose_backend; echo "$backend ($backend_why)" ;;
  *) usage ;;
esac
